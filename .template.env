# Export these variables in your shell; the server does not load this file.
NGSI_LD_BROKER_URL=http://localhost:1026
NGSI_LD_TIMEOUT=10
NGSI_LD_ENABLE_WRITES=false
NGSI_LD_HEADERS='{}'
NGSI_LD_MAX_RESPONSE_BYTES=2000000
# Optional default context; must be resolvable by the broker.
# NGSI_LD_CONTEXT_URL=http://context:3000/context.jsonld
NGSI_LD_CONTEXT_URLS='[]'
